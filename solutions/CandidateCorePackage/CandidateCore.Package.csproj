<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>os_sr_cact</AssemblyName>
    <RootNamespace>os_sr_cact</RootNamespace>
    <PackageId>os_sr_cact_pkg</PackageId>
    <Version>1.0.6</Version>
    <Authors>BSO-RS-Support</Authors>
    <Company>BSO-RS-Support</Company>
    <Description>Candidate Core Dataverse plug-in package.</Description>
    <AssemblyVersion>1.0.6.0</AssemblyVersion>
    <FileVersion>1.0.6.0</FileVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <SignAssembly>false</SignAssembly>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\CandidateCore\DataversePlugin.cs" Link="DataversePlugin.cs" />
    <Compile Include="..\CandidateCore\Operation.cs" Link="Operation.cs" />
    <Compile Include="..\CandidateCore\SyntheticIsolation.cs" Link="SyntheticIsolation.cs" />
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.60" PrivateAssets="All" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="Microsoft.PowerApps.MSBuild.Plugin" Version="1.52.1" PrivateAssets="All" />
  </ItemGroup>
</Project>
