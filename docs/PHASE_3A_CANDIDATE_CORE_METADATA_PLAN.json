  "customApi": {
    "uniqueName": "os_sr_cact",
    "displayName": "Apply Candidate Action",
    "kind": "Action",
    "binding": "Unbound",
    "implementation": "Synchronous main-operation plug-in",
    "inputs": [
      "CandidateId: Guid, required",
      "ActionType: String allowlist, required",
      "ExpectedStatus: Integer, required for transitions",
      "IdempotencyKey: URL-safe opaque string, required",
      "Reason: String, conditional",
      "CorrelationId: String, conditional",
      "CallOutcome: String, required for RecordCall pending approved taxonomy",
      "ContactedAt: DateTime, required for RecordCall",
      "Notes: String, optional",
      "RescheduleEvidenceId: String, required for RequestReschedule"
    ],
    "outputs": [
      "ResultCode: Applied or DuplicateReplay",
      "PreviousStatus",
      "CurrentStatus",
      "CallLogId when created",
      "StatusHistoryId when created"
    ],
    "rules": [
      "Action allowlist maps to fixed transitions; caller cannot submit arbitrary target status.",
      "Use authenticated initiating user as actor; never trust actor IDs supplied by clients.",
      "Compare ExpectedStatus and Dataverse RowVersion; reject stale/conflicting updates.",
      "Idempotent replay returns original result; same key with different payload is rejected.",
      "Commit Candidate update, Call Log, and exactly one Status History row atomically when applicable.",
      "No external provider call is made by this Phase 3A operation."
    ]
  },
  "provisioning": {
    "authorized": false,
    "maximumTenantWrites": 0,
    "sequence": [
      "Create or verify global Choice",
      "Create Candidate table",
      "Add Candidate columns and lookups to existing approved reference tables",
      "Resolve LEGO Career target dependency before creating that lookup",
      "Create Call Log table and columns",
      "Create Candidate Status History table and columns",
      "Create alternate keys after table/column metadata propagation",
      "Verify exact Solution membership",
      "Use only separately approved bounded publication/reconciliation"
    ],
    "businessOperationSeparateFromSchema": true
  },
