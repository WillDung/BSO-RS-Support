      "condition": "Move to manual scheduling only; future booking boundary validates CV URL and linked LEGO Career.",
      "to": "Waiting Manual Scheduling",
      "allowed": true
    },
    {
      "from": "Waiting Manual Scheduling",
      "action": "MarkRound1Scheduled",
      "condition": "Future scheduler has a verified successful booking result",
      "to": "Round 1 Scheduled",
      "allowed": true
    },
    {
      "from": "Round 1 Scheduled",
      "action": "RecordPass",
      "condition": "Future authorized interview-result evidence is Pass",
      "to": "Offer Extended",
      "allowed": true
    },
    {
      "from": "Round 1 Scheduled",
      "action": "RecordFail",
      "condition": "Future authorized interview-result evidence is Fail",
      "to": "Candidate Failed",
      "allowed": true
    },
    {
      "from": "Round 1 Scheduled",
      "action": "RequestReschedule",
      "condition": "Mandatory reason is recorded; calendar/event cancellation attempt and its evidence are owned by the later scheduling phase.",
      "executionStatus": "DeferredUntilSchedulingBoundary",
      "to": "Need Call Candidate",
      "allowed": true
    }
  ],
  "customApi": {
    "uniqueName": "os_sr_cact",
    "displayName": "Apply Candidate Action",
    "kind": "Action",
    "binding": "Unbound",
    "implementation": "Synchronous main-operation plug-in",
    "inputs": [
      "CandidateId: Guid, required except for CreateCandidate",
      "ActionType: String allowlist, required",
      "ExpectedStatus: Integer, required for transitions",
      "CorrelationId: Guid, caller-generated and required for every state-changing operation",
      "CandidateName: String, required for CreateCandidate",
      "CandidateEmail: String, required for CreateCandidate",
      "CandidatePhone: String, optional for CreateCandidate",
      "PositionId: Guid, optional for CreateCandidate",
      "CandidateSourceId: Guid, optional for CreateCandidate",
      "Reason: String, required for RequestReschedule",
      "CallOutcome: os_sr_callout value, required for RecordCall",
      "ContactedAt: DateTime, required for RecordCall",
      "Notes: String, optional"
    ],
    "outputs": [
      "ResultCode: Applied or DuplicateReplay",
      "PreviousStatus",
      "CurrentStatus",
      "CallLogId when created",
      "StatusHistoryId when created"
    ],
    "rules": [
      "CreateCandidate, UpdateCandidate, and workflow actions are allowlisted; caller cannot submit arbitrary target status.",
      "Use authenticated initiating user as actor; never trust actor IDs supplied by clients.",
      "CreateCandidate assigns Dataverse ownerid to the authenticated initiating BSO and omits any Assigned BSO duplicate lookup.",
      "CorrelationId is a caller-generated GUID, required for every state-changing operation and reused only for retries of that logical operation.",
      "Compare ExpectedStatus and Dataverse RowVersion; reject stale/conflicting updates.",
      "Unique Candidate/Call/History correlation keys prevent duplicate Candidate creates, Call Logs, and transition History rows; replay payloads are checked for conflict.",
      "UpdateCandidate uses replacement values; an identical replay is a no-op and creates no Call Log, History row, or status transition; CorrelationId remains required.",
      "Commit Candidate update, Call Log, and exactly one Status History row atomically when applicable.",
      "Answered calls atomically write Call Log, Candidate status, and one History row; non-answer outcomes write only Call Log and do not change status.",
      "Candidate Number is generated by Dataverse, nonpersonal, immutable after create, and protected by a unique alternate key.",
      "Reschedule requires a reason and writes actor, server timestamp, correlation ID, previous/new status, and reason; the action remains unavailable until the later cancellation-attempt boundary is implemented.",
      "No external provider call is made by this Phase 3A operation."
    ]
  },
